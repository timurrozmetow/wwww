# Production env for docker-compose.prod.yml.
# Copy to deploy/.env.production (gitignored) and fill REAL values.
#   cp deploy/.env.production.example deploy/.env.production
# Used both for ${...} interpolation in compose AND as the backend env_file.

# ---- Public API hostname (DNS A record -> this VPS, ports 80/443 open) -------
DOMAIN=api.example.com

# ---- MySQL (not published to the host; only the backend reaches it) ----------
MYSQL_ROOT_PASSWORD=CHANGE_ME_STRONG_ROOT_PASSWORD
MYSQL_DATABASE=vpn
MYSQL_USER=vpn
MYSQL_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD
# NOTE: DATABASE_URL and REDIS_URL are set by compose (point at the mysql/redis
# services) — do not set them here.

# ---- Runtime ----------------------------------------------------------------
LOG_LEVEL=info
# Generate a long random secret, e.g.  openssl rand -hex 32
JWT_SECRET=CHANGE_ME_LONG_RANDOM_ADMIN_JWT_SECRET
ADMIN_TOKEN_TTL=12h

# Seed admin (used once by `admin:create`).
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=CHANGE_ME_STRONG_ADMIN_PASSWORD

# ---- Ads / rewards ----------------------------------------------------------
# Keep test units for the control-plane test; set REAL ids before public release.
ADMOB_APP_ID=ADMOB_APP_ID_PLACEHOLDER
ADMOB_REWARDED_UNIT_ID=ca-app-pub-3940256099942544/5224354917
# AdMob SSV public key (key server) — required to verify callbacks in prod.
ADMOB_SSV_KEY=ADMOB_SSV_KEY_PLACEHOLDER
# Keep 'true' in production. Reward is granted ONLY on a verified SSV callback.
ADMOB_SSV_VERIFY=true

# ---- Observability (optional but recommended) -------------------------------
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0

# ---- Push / FCM (Stage 6) — optional; false = campaigns tracked, not delivered
FCM_ENABLED=false
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT=

# ---- Anti-fraud / Play Integrity (Stage 8) — optional -----------------------
PLAY_INTEGRITY_ENABLED=false
PLAY_INTEGRITY_PROJECT_NUMBER=
