# ============================================================================
#  free-vpn-rewards — environment template
#  Copy to `.env` and fill REAL values locally. NEVER commit `.env`.
#  Per CLAUDE.md §7/§13: real secrets, VPN keys, ad unit ids and subscription
#  URLs live ONLY here, never in code. Code/tests use the *_PLACEHOLDER tokens.
# ============================================================================

# ---- Runtime ----------------------------------------------------------------
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info

# ---- Database (MySQL) -------------------------------------------------------
# Matches docker-compose.yml defaults for local dev.
DATABASE_URL=mysql://vpn:vpn_password@127.0.0.1:3306/vpn

# ---- Redis (must run with AOF persistence — see docker-compose.yml) ----------
REDIS_URL=redis://127.0.0.1:6379

# ---- Observability (Sentry) -------------------------------------------------
# Leave empty to disable Sentry locally.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0
# Mobile crash reporting DSN (Expo / @sentry/react-native), wired in a later stage.
EXPO_PUBLIC_SENTRY_DSN=

# ---- Admin auth (Stage 4) ---------------------------------------------------
JWT_SECRET=CHANGE_ME_ADMIN_JWT_SECRET_PLACEHOLDER
ADMIN_TOKEN_TTL=12h
# Optional defaults for `pnpm --filter @vpn/backend admin:create`.
ADMIN_EMAIL=admin@local
ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD_PLACEHOLDER
# Admin SPA -> backend base URL (Vite). Defaults to http://localhost:3000.
VITE_API_BASE_URL=http://localhost:3000

# ---- Mobile build (Expo/EAS) — EXPO_PUBLIC_* are inlined into the APK, NOT secret.
# Backend base URL the phone uses. The emulator alias 10.0.2.2 = host localhost;
# a real device needs the deployed backend URL (set per EAS profile in eas.json).
EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:3000
# AdMob *app* id (not a secret). Defaults to Google's public test app id; set the
# real one as an EAS secret for production builds.
EXPO_PUBLIC_ADMOB_ANDROID_APP_ID=ca-app-pub-3940256099942544~3347511713
# EAS project id (filled by `eas init`).
EAS_PROJECT_ID=EAS_PROJECT_ID_PLACEHOLDER

# ---- Push notifications / FCM (Stage 6) -------------------------------------
# false → no-op sender (dev/test, campaigns are tracked but nothing is delivered).
# true  → real FCM send; requires FCM_PROJECT_ID + FCM_SERVICE_ACCOUNT.
FCM_ENABLED=false
FCM_PROJECT_ID=FCM_PROJECT_ID_PLACEHOLDER
# Path to the FCM service-account JSON (kept outside the repo) or inline JSON.
FCM_SERVICE_ACCOUNT=./secrets/fcm-service-account.json

# ---- Ads: mediation + units (Stage 2/5) -------------------------------------
APPLOVIN_SDK_KEY=APPLOVIN_SDK_KEY_PLACEHOLDER
ADMOB_APP_ID=ADMOB_APP_ID_PLACEHOLDER
ADMOB_REWARDED_UNIT_ID=ADMOB_REWARDED_UNIT_ID_PLACEHOLDER
ADMOB_SSV_KEY=ADMOB_SSV_KEY_PLACEHOLDER
APPLOVIN_REWARDED_UNIT_ID=APPLOVIN_REWARDED_UNIT_ID_PLACEHOLDER
UNITY_GAME_ID=UNITY_GAME_ID_PLACEHOLDER
# Verify AdMob SSV signatures. Keep 'true' in prod; 'false' only for local test ads.
ADMOB_SSV_VERIFY=true

# ---- Anti-fraud: Play Integrity (Stage 8) -----------------------------------
# false → integrity tokens are NOT verified (heuristic-only scoring, dev/test).
# true  → verify Play Integrity tokens; needs the project number + creds below.
PLAY_INTEGRITY_ENABLED=false
PLAY_INTEGRITY_PROJECT_NUMBER=PLAY_INTEGRITY_PROJECT_NUMBER_PLACEHOLDER
PLAY_INTEGRITY_DECRYPTION_KEY=PLAY_INTEGRITY_DECRYPTION_KEY_PLACEHOLDER

# ---- VPN providers / subscriptions (Stage 3) --------------------------------
# Real subscription URLs and keys are stored encrypted in the DB via the admin
# panel, NOT here. These placeholders only document the accepted formats.
HAPP_CRYPT4_PLACEHOLDER=happ://crypt4/HAPP_CRYPT4_PLACEHOLDER
VLESS_PLACEHOLDER=vless://VLESS_PLACEHOLDER
VMESS_PLACEHOLDER=vmess://VMESS_PLACEHOLDER
TROJAN_PLACEHOLDER=trojan://TROJAN_PLACEHOLDER
WIREGUARD_PLACEHOLDER=WIREGUARD_PLACEHOLDER

# Happ "crypt" decoder keys (BYOK). To accept happ://crypt{N} links pasted in the
# admin panel, supply the matching RSA *private* key(s) extracted from the Happ
# client. PEMs are stored single-line with literal \n (un-escaped at load).
# Leave blank → happ links are rejected (sub-URL / vless / vmess still work).
# NOTE: only the version(s) you actually use are required (crypt4 is current).
HAPP_PRIVATE_KEY_CRYPT=
HAPP_PRIVATE_KEY_CRYPT2=
HAPP_PRIVATE_KEY_CRYPT3=
HAPP_PRIVATE_KEY_CRYPT4=HAPP_PRIVATE_KEY_CRYPT4_PLACEHOLDER

# ---- Mobile -> backend ------------------------------------------------------
# Expo reads EXPO_PUBLIC_* at build time.
EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:3000
